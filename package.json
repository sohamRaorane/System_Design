{
  "name": "system-design",
  "version": "0.1.0",
  "private": true,
  "description": "Group 21 — OpenTelemetry pipeline with tail-based sampling, batch indexing and cold archival",
  "workspaces": [
    "apps/*",
    "tools/*"
  ],
  "engines": {
    "node": ">=20.4"
  },
  "scripts": {
    "start": "npm run start -w @system-design/collector",
    "dev": "npm run dev -w @system-design/collector",
    "test": "npm test --workspaces --if-present",
    "reset": "npm run reset -w @system-design/collector",
    "loadgen": "npm run loadgen -w @system-design/loadgen",
    "loadgen:burst": "npm run loadgen:burst -w @system-design/loadgen",
    "reconcile": "npm run reconcile -w @system-design/loadgen"
  }
}
