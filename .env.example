# Copy to .env (never commit .env). Values shown are development defaults.
# Production (NODE_ENV=production) refuses to start without DATABASE_URL, JWT_PRIVATE_KEY,
# ADMIN_TOKEN, WEB_ORIGIN and the GitHub sign-in credentials.

# ---- collector (apps/collector) ----
NODE_ENV=development
PORT=4318
LOG_LEVEL=info                      # debug | info | warn | error | silent
PUBLIC_URL=http://localhost:4318    # this collector's public URL (shown as the OTLP endpoint)
WEB_ORIGIN=http://localhost:5173    # the dashboard's URL (OAuth callback + post-login redirect)
# DATABASE_URL=postgres://user:pass@host/db?sslmode=require   # cloud; unset = local SQLite
DB_PATH=data/telemetry.db
COLD_DIR=cold
# WEB_DIST=../web/dist              # serve the built dashboard from the collector (single service)

# Operator token for /v1/config, /v1/faults, /v1/admin/*, /metrics (required in production, ≥24 chars)
ADMIN_TOKEN=
# GitHub logins (comma-separated) that are administrators in the dashboard
ADMIN_GITHUB_LOGINS=
# RSA private key (PEM, "\n" escapes allowed). Development generates one in data/ when unset.
JWT_PRIVATE_KEY=
# Sign in without GitHub for local development and tests (never works in production)
DEV_LOGIN=true
# Accept spans without an API key into the "default" project (default: true in development only)
ALLOW_ANONYMOUS_INGEST=true

# ---- GitHub App (sign-in + repository access) ----
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=

# ---- cold archive on Cloudflare R2 / any S3-compatible store (Phase 5) ----
# R2_ACCOUNT_ID=  R2_BUCKET=  R2_ACCESS_KEY_ID=  R2_SECRET_ACCESS_KEY=

# ---- load generator (tools/loadgen) ----
COLLECTOR_URL=http://localhost:4318
