# Copy to .env (never commit .env). Values shown are the defaults.

# ---- collector (apps/collector) ----
PORT=4318
LOG_LEVEL=info                 # debug | info | warn | error | silent
DB_PATH=data/telemetry.db      # SQLite hot store (local dev)
COLD_DIR=cold                  # local cold archive folder (local dev)
# CONFIG_PATH=config/default.json
# Required in any shared or deployed environment: guards PUT /v1/config, PUT /v1/faults, /v1/admin/*
ADMIN_TOKEN=change-me

# ---- load generator (tools/loadgen) ----
COLLECTOR_URL=http://localhost:4318

# ---- added in later phases (not used yet) ----
# Phase 2  GITHUB_CLIENT_ID=  GITHUB_CLIENT_SECRET=  JWT_PRIVATE_KEY=  WEB_ORIGIN=http://localhost:5173
# Phase 3  GITHUB_APP_ID=  GITHUB_APP_PRIVATE_KEY=  GITHUB_WEBHOOK_SECRET=
# Phase 5  DATABASE_URL=  R2_ACCOUNT_ID=  R2_ACCESS_KEY_ID=  R2_SECRET_ACCESS_KEY=  R2_BUCKET=
